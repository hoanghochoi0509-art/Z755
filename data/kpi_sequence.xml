<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_kpi_catalog" model="ir.sequence">
        <field name="name">Mã KPI</field><field name="code">kpi.catalog</field>
        <field name="prefix">KPI-</field><field name="padding">4</field>
    </record>
    <record id="seq_kpi_rule" model="ir.sequence">
        <field name="name">Mã rule chấm</field><field name="code">kpi.scoring.rule</field>
        <field name="prefix">QT-</field><field name="padding">3</field>
    </record>
    <record id="seq_kpi_rule_inline" model="ir.sequence">
        <field name="name">Mã rule trực tiếp</field><field name="code">kpi.scoring.rule.inline</field>
        <field name="prefix">INL-</field><field name="padding">5</field>
    </record>
    <record id="seq_kpi_assignment" model="ir.sequence">
        <field name="name">Số bảng giao KPI</field><field name="code">kpi.assignment</field>
        <field name="prefix">BG/%(year)s/</field><field name="padding">4</field>
    </record>
</odoo>

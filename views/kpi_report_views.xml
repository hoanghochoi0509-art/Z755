<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_kpi_report_summary" model="ir.actions.act_window">
        <field name="name">Tổng hợp điểm theo đơn vị</field><field name="res_model">kpi.assignment.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('object_type','=','department')]</field>
        <field name="context">{'search_default_g_dept': 1}</field>
    </record>
    <record id="action_kpi_report_personal" model="ir.actions.act_window">
        <field name="name">Tổng hợp điểm cá nhân</field><field name="res_model">kpi.assignment</field>
        <field name="view_mode">list,pivot</field>
        <field name="domain">[('object_type','=','employee')]</field>
    </record>
    <record id="action_kpi_report_overdue" model="ir.actions.act_window">
        <field name="name">KPI quá hạn / chưa hoàn thành</field><field name="res_model">kpi.assignment.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('overdue','=',True)]</field>
    </record>
    <record id="action_kpi_report_deducted" model="ir.actions.act_window">
        <field name="name">KPI bị trừ điểm</field><field name="res_model">kpi.assignment.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('has_system_score','=',True),('system_score','&lt;',100)]</field>
    </record>
    <record id="action_kpi_report_diff" model="ir.actions.act_window">
        <field name="name">Chênh lệch tự chấm - thẩm định - Tổ KPI - kết luận</field><field name="res_model">kpi.assignment.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('diff_flag','=',True)]</field>
    </record>
    <record id="action_kpi_report_audit" model="ir.actions.act_window">
        <field name="name">Lịch sử điều chỉnh / audit</field><field name="res_model">kpi.audit.log</field>
        <field name="view_mode">list</field>
    </record>
    <record id="view_kpi_audit_list" model="ir.ui.view">
        <field name="name">kpi.audit.log.list</field><field name="model">kpi.audit.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"><field name="change_date"/><field name="user_id"/><field name="assignment_id"/>
                <field name="record_name"/><field name="field_name"/><field name="old_value"/><field name="new_value"/><field name="reason"/></list>
        </field>
    </record>
    <record id="view_kpi_assignment_pivot" model="ir.ui.view">
        <field name="name">kpi.assignment.pivot</field><field name="model">kpi.assignment</field>
        <field name="arch" type="xml">
            <pivot><field name="target_name" type="row"/><field name="period_id" type="col"/>
                <field name="total_self" type="measure"/><field name="total_reviewer" type="measure"/>
                <field name="total_team" type="measure"/><field name="total_final" type="measure"/></pivot>
        </field>
    </record>
    <!-- Bảng điều khiển: tổng hợp theo trạng thái -->
    <record id="view_kpi_assignment_graph" model="ir.ui.view">
        <field name="name">kpi.assignment.graph</field><field name="model">kpi.assignment</field>
        <field name="arch" type="xml">
            <graph type="bar"><field name="state"/></graph>
        </field>
    </record>
    <record id="action_kpi_dashboard_client" model="ir.actions.client">
        <field name="name">Bảng điều khiển</field>
        <field name="tag">z755_kpi.dashboard</field>
    </record>
    <record id="action_kpi_dashboard" model="ir.actions.act_window">
        <field name="name">Thống kê bảng giao</field><field name="res_model">kpi.assignment</field>
        <field name="view_mode">graph,pivot,list</field>
    </record>
</odoo>
